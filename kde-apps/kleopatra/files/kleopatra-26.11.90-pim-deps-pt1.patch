 # Standalone build. Find / include everything necessary.
 set(KF_MIN_VERSION "6.30.0")
-set(KIDENTITYMANAGEMENT_VERSION "6.8.90")
-set(KMAILTRANSPORT_VERSION "6.8.90")
-set(AKONADI_MIME_VERSION "6.8.90")
 set(LIBKLEO_VERSION "6.8.90")
-set(QT_REQUIRED_VERSION "6.7.0")
 set(MIMETREEPARSER_VERSION "6.8.90")
+set(PIM_MIN_VERSION "6.7.0")
